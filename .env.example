PIXVERSE_IMAGE_MODEL=gemini-3.1-flash-lite
PIXVERSE_TIMEOUT_SEC=
MYSQL_DB_HOST=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
