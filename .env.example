OPENAI_API_KEY=
TELEGRAM_BOT_TOKEN=
FREEPIK_API_KEY=
# Cloudflare Workers AI image generation - currently disabled, kept for fallback (see src/utils/imageUtils.js)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# PixVerse CLI image generation - optional overrides, auth is done via `pixverse auth login` (no API key)
PIXVERSE_ASPECT_RATIO=
# gpt-image-2.0 (CLI default) requires a paid plan; gemini-3.1-flash-lite works on Free (6 credits/image)
PIXVERSE_IMAGE_MODEL=gemini-3.1-flash-lite
PIXVERSE_TIMEOUT_SEC=
# PixVerse CLI image-to-video generation - reuses a daily image, so no extra image cost.
# T2V and I2V are priced identically (same per-second rate); 360p/5s/no-audio keeps it cheap
# (360p = cheapest v6 tier, ~640x640 at 1:1 aspect ratio vs 1024x1024 for 540p).
PIXVERSE_VIDEO_MODEL=v6
PIXVERSE_VIDEO_QUALITY=360p
PIXVERSE_VIDEO_DURATION=5
PIXVERSE_VIDEO_AUDIO=false
PIXVERSE_VIDEO_TIMEOUT_SEC=600
MYSQL_DB_HOST=
MYSQL_ROOT_PASSWORD=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
CHANNEL_EN=
CHANNEL_RU=
CHANNEL_AM=